 },
 "components": {
  "schemas": {
   "ApproveIn": {
    "properties": {
     "note": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "note"
    ],
    "title": "ApproveIn"
   },
   "Event": {
    "properties": {
     "event_id": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1,
      "title": "Event Id",
      "description": "the source system's id; a replay is ignored"
     },
     "kind": {
      "type": "string",
      "pattern": "^(unit_build|rework|reel_scan)$",
      "title": "Kind"
     },
     "at": {
      "type": "string",
      "format": "date-time",
      "title": "At"
     },
     "serial": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 40
       },
       {
        "type": "null"
       }
      ],
      "title": "Serial"
     },
     "board_serial": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 40
       },
       {
        "type": "null"
       }
      ],
      "title": "Board Serial"
     },
     "reel": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 40
       },
       {
        "type": "null"
       }
      ],
      "title": "Reel"
     },
     "line": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 9.0,
        "minimum": 1.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Line"
     }
    },
    "type": "object",
    "required": [
     "event_id",
     "kind",
     "at"
    ],
    "title": "Event"
   },
   "EventsIn": {
    "properties": {
     "generate": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Generate"
       },
       {
        "type": "null"
       }
      ]
     },
     "events": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/components/schemas/Event"
        },
        "type": "array",
        "maxItems": 2000
       },
       {
        "type": "null"
       }
      ],
      "title": "Events"
     }
    },
    "type": "object",
    "title": "EventsIn"
   },
   "Generate": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 11
     }
    },
    "type": "object",
    "title": "Generate"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IncidentIn": {
    "properties": {
     "supplier_lot": {
      "type": "string",
      "maxLength": 20,
      "minLength": 1,
      "title": "Supplier Lot"
     },
     "date_code_from": {
      "type": "string",
      "format": "date",
      "title": "Date Code From"
     },
     "date_code_to": {
      "type": "string",
      "format": "date",
      "title": "Date Code To"
     },
     "source": {
      "type": "string",
      "maxLength": 120,
      "title": "Source",
      "default": "supplier notice"
     },
     "description": {
      "type": "string",
      "maxLength": 1000,
      "title": "Description",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "supplier_lot",
     "date_code_from",
     "date_code_to"
    ],
    "title": "IncidentIn"
   },
   "NoticesIn": {
    "properties": {
     "recall_id": {
      "type": "string",
      "format": "uuid",
      "title": "Recall Id"
     }
    },
    "type": "object",
    "required": [
     "recall_id"
    ],
    "title": "NoticesIn"
   },
   "ScopeIn": {
    "properties": {
     "incident_id": {
      "type": "string",
      "format": "uuid",
      "title": "Incident Id"
     },
     "max_expected_escapes": {
      "type": "number",
      "maximum": 50.0,
      "minimum": 0.0,
      "title": "Max Expected Escapes",
      "description": "affected units the recall may expect to leave out",
      "default": 0.5
     },
     "exclude_above": {
      "type": "number",
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Exclude Above",
      "description": "no unit with a higher probability is left out",
      "default": 0.01
     }
    },
    "type": "object",
    "required": [
     "incident_id"
    ],
    "title": "ScopeIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}