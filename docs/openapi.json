  "/v1/units/{serial}/genealogy": {
   "get": {
    "tags": [
     "genealogy"
    ],
    "summary": "One unit's genealogy: the board it holds (or the spares it might hold after a rework), the reels on each board with probabilities, the lots those reels came from, where the unit went, and every recall it is in",
    "operationId": "genealogy_v1_units__serial__genealogy_get",
    "parameters": [
     {
      "name": "serial",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Serial"
      }
     },
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
